# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xrpl_nft_marketplace
DB_USER=root
DB_PASSWORD=your_password_here
DB_DIALECT=mysql

# Test Database
DB_TEST_NAME=xrpl_nft_marketplace_test

# XRPL Configuration
XRPL_NETWORK=mainnet
XRPL_WSS_URL=wss://xrplcluster.com
# For testnet use: wss://s.altnet.rippletest.net:51233
# For devnet use: wss://s.devnet.rippletest.net:51233

# Admin Wallet (for minting, marketplace operations)
ADMIN_WALLET_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ADMIN_WALLET_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Marketplace Configuration
MARKETPLACE_FEE_PERCENTAGE=2.5
MIN_LISTING_PRICE=1

# Pinata IPFS Gateway Configuration
PINATA_GATEWAY_URL=https://purple-deliberate-giraffe-336.mypinata.cloud/ipfs
PINATA_GATEWAY_TOKEN=your-pinata-gateway-token-here

# Bithomp API Configuration (for NFT transaction history)
BITHOMP_API_KEY=your-bithomp-api-key-here
BITHOMP_API_URL=https://bithomp.com/api/v2
