# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/xrpl-nft-marketplace
MONGODB_TEST_URI=mongodb://localhost:27017/xrpl-nft-marketplace-test

# XRPL Configuration
XRPL_NETWORK=testnet
XRPL_WSS_URL=wss://s.altnet.rippletest.net:51233
# For mainnet use: wss://xrplcluster.com
# For devnet use: wss://s.devnet.rippletest.net:51233

# Admin Wallet (for minting, marketplace operations)
ADMIN_WALLET_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ADMIN_WALLET_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Marketplace Configuration
MARKETPLACE_FEE_PERCENTAGE=2.5
MIN_LISTING_PRICE=1
